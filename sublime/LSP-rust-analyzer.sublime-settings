{
  // rust-analyzer：使用非 "auto" 的 server_path 禁用插件自动下载，通过双架构 PATH
  // 兼容 Apple Silicon (/opt/homebrew)、Intel (/usr/local)、~/.local/bin 与 rustup (~/.cargo/bin)，
  // 并确保从 Finder 启动的 Sublime 能找到 cargo / rustc。
  "selector": "source.rust",
  "schemes": [
    "file",
    "buffer"
  ],
  "server_path": "rust-analyzer",
  "command": [
    "rust-analyzer"
  ],
  "env": {
    "PATH": "${home}/.cargo/bin:${home}/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin"
  },
  "initialization_options": {
    "checkOnSave": true,
    "check.command": "clippy",
    "cargo.allFeatures": true,
    "cargo.buildScripts.enable": true,
    "procMacro.enable": true,
    "completion.autoimport.enable": true,
    "inlayHints.typeHints": true,
    "inlayHints.parameterHints": true,
    "inlayHints.chainingHints": true,
    "inlayHints.closingBraceHints.enable": true
  }
}
