{
  // ruff：负责 Python lint 与保存时格式化（配合 ~/.config/ruff/ruff.toml）。
  // ty：负责 Python 类型检查、补全与跳转，两者同时挂在 Python 视图上。
  // 使用 ${home} 与双架构 Homebrew PATH，兼容 Apple Silicon (/opt/homebrew) 与 Intel (/usr/local)。
  "ruff": {
    "enabled": true,
    "command": [
      "ruff",
      "server"
    ],
    "selector": "source.python",
    "env": {
      "PATH": "${home}/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin"
    }
  },
  "ty": {
    "enabled": true,
    "command": [
      "ty",
      "server"
    ],
    "selector": "source.python",
    "env": {
      "PATH": "${home}/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin"
    }
  }
}
