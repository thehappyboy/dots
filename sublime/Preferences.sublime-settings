{
  "ignored_packages": [
    "Vintage"
  ],
  "index_files": false,
  "theme": "Default.sublime-theme",
  "color_scheme": "Packages/Catppuccin color schemes/build/Catppuccin Latte.sublime-color-scheme",
  "font_face": "BerkeleyMono Nerd Font",
  "font_size": 14,
  "font_options": [
    "no_calt"
  ],
  "line_padding_top": 3,
  "line_padding_bottom": 3,
  "tab_size": 4,
  "translate_tabs_to_spaces": true,
  "detect_indentation": true,
  "draw_white_space": [
    "selection"
  ],
  "highlight_line": true,
  "highlight_modified_tabs": true,
  "show_minimap": false,
  "word_wrap": false,
  "rulers": [
    100
  ],
  "ensure_newline_at_eof_on_save": true,
  "trim_trailing_white_space_on_save": "all",
  "show_encoding": true,
  "show_line_endings": true,
  "scroll_past_end": true,
  "show_git_status": true,
  "folder_exclude_patterns": [
    ".git",
    "node_modules",
    ".venv",
    "__pycache__",
    "target",
    ".next",
    "dist",
    ".mypy_cache",
    ".pytest_cache",
    ".ruff_cache"
  ]
}
