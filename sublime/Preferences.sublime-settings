{
	"ignored_packages":
	[
		"Vintage",
	],
	"color_scheme": "auto",
	"dark_color_scheme": "Catppuccin Frappe.sublime-color-scheme",
	"light_color_scheme": "Catppuccin Latte.sublime-color-scheme",
	"themed_title_bar": true,


	"index_files": true,


	"font_face": "BerkeleyMono Nerd Font",
	"font_faces": [
		"BerkeleyMono Nerd Font",
		"JetBrainsMono Nerd Font Mono",
		"MonoLisa Nerd Font",
		"GeistMono Nerd Font",
		"CamingoCode Nerd Font",
		"OperatorMono Nerd Font"
	],

	"font_size": 14,
	"default_font_size": 14,

	"tab_size": 2,
	"translate_tabs_to_spaces": true,
	"ensure_newline_at_eof_on_save": true,

	"neovintageous_build_version": 13200,

	"show_sidebar_on_project_open": true,

	"lsp.disable_on_hover": false,
  "lsp.disable_on_hover_gutter": false,
  "lsp.disable_on_hover_text": true,
  "lsp.ignore_files_containing": ["/vendor/", "/node_modules/"],
}
